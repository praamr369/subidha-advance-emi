[Unit]
Description=SUBIDHA CORE Next.js Frontend
After=network.target

[Service]
User=subidha
Group=subidha
WorkingDirectory=/var/www/subidha/app/frontend
EnvironmentFile=-/etc/subidha/frontend.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
