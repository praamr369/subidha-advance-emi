# Python / Django
# ------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.sqlite3
# SQLite writes a sibling journal/WAL while a transaction is open; the pattern
# above does not cover it, and a file-backed test database (SUBIDHA_TEST_DB_FILE)
# leaves one behind whenever a run is interrupted.
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.log
*.pot
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
dist/
build/
*.egg-info/
.eggs/
.env
.env.*
.venv/
venv/
media/
staticfiles/

