{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "subidha-admin",
  "version": "0.1.0",
  "identifier": "com.subidha.admin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "",
    "frontendDist": "https://subidhafurnitureasansol.com"
  },
  "app": {
    "windows": [
      {
        "title": "SUBIDHA CORE — Business Control Center",
        "url": "/admin",
        "width": 1280,
        "height": 768,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
